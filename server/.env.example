# Server
PORT=5000
NODE_ENV=development

# Comma separated list of allowed browser origins. Localhost is always allowed outside production.
CLIENT_URL=http://localhost:5173

# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Demo OTP accepted by /api/auth/verify-otp
DEMO_OTP=1234

# Max JSON request body size
JSON_BODY_LIMIT=100kb
